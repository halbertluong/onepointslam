# Environment variables read by the app. Copy to .env.local for local
# development; set the same names in the Vercel project for deployments.
# Values here are placeholders — never commit real credentials.
#
# Vercel applies an environment variable change only to NEW deployments, so
# after editing one there, redeploy or the old value stays live.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
# All tenants share this one platform account; a charge is tied back to its
# tenant, tournament and registrant through PaymentIntent metadata rather than
# through per-tenant Connect accounts.
#
# Both keys must come from the SAME Stripe account and mode — a sandbox has its
# own key pair, and mixing a sandbox key with a live-mode one fails at checkout.
# Copy each key with the dashboard's Reveal + copy control: copying the masked
# display captures bullet characters (•) that cannot be sent as an HTTP header,
# which surfaces as a misleading "connection to Stripe" error.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret for the webhook at /api/webhooks/stripe, used to prove an
# incoming event genuinely came from Stripe. It is generated per endpoint, so
# it only exists once the endpoint is created (Developers -> Webhooks), and a
# sandbox endpoint and a live one have different secrets.
#
# The endpoint keeps payment_status accurate after signup — refunds, and the
# slower payment methods (bank debit, Klarna, Affirm, Cash App) that confirm
# minutes or days later. Subscribe it to exactly these events:
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   payment_intent.canceled
#   charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=One Point Bowl <noreply@example.com>

# ── Rate limiting (Upstash) ──────────────────────────────────────────────────
# Optional. Without both, the middleware skips rate limiting entirely.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────────
# Absolute origin, used to build links in outgoing email.
NEXT_PUBLIC_SITE_URL=https://onepointbowl.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Shared secret guarding internal service-to-service API calls.
INTERNAL_API_SECRET=
# Code a new tournament director enters to self-register.
DIRECTOR_INVITE_CODE=
